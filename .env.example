# Admin gate for the /artifacts management surface (OpenSpec change: admin-auth).
# Set these on the MAIN APP Railway service ONLY — never on the artifact-server
# service, which stays public and read-only.
#
# For local development, copy this file to `.env.local` and fill in values
# (`.env*.local` is gitignored).

# The admin password entered at /login. Use a long, high-entropy value.
ARTIFACTS_SECRET=

# HMAC key used to sign the session cookie. Use a long, random value,
# independent of ARTIFACTS_SECRET.
SESSION_SECRET=

# S3 / Railway Bucket connection for uploading & listing artifacts. Reuses the
# SAME bucket and key pair as the artifact-server service (Railway issues a
# single full-access key — there is no read-only scope). Set these on the MAIN
# APP service ONLY; adding write credentials to artifact-server would break its
# read-only, public isolation. On Railway, point them at the shared Bucket via
# reference variables (or copy its connection details).
ARTIFACTS_S3_ENDPOINT=
ARTIFACTS_S3_REGION=
ARTIFACTS_S3_ACCESS_KEY_ID=
ARTIFACTS_S3_SECRET_ACCESS_KEY=
ARTIFACTS_S3_BUCKET=
# Optional. Railway Buckets use virtual-hosted-style URLs, so leave unset unless
# testing shows path-style is required.
ARTIFACTS_S3_FORCE_PATH_STYLE=
